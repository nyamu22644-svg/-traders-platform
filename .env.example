# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Get these from your Supabase project settings -> API
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Deriv client auth
# OAuth2 client id from Deriv App Manager.
VITE_DERIV_CLIENT_ID="YOUR_DERIV_OAUTH_CLIENT_ID"
# Backward-compatible alias accepted by the app.
VITE_DERIV_APP_ID="YOUR_DERIV_OAUTH_CLIENT_ID"

# OAuth authorization endpoint.
VITE_DERIV_OAUTH_URL="https://auth.deriv.com/oauth2/auth"
# Recommended OAuth scopes for trading + account management.
VITE_DERIV_OAUTH_SCOPE="trade account_manage"
# Optional visual crop for the embedded Deriv DBot header area.
# This does not modify DBot internally; it only clips the iframe from the parent page.
# VITE_DERIV_DBOT_TOPBAR_OFFSET="220"
# Optional per-breakpoint overrides for cleaner masking on all devices.
# VITE_DERIV_DBOT_TOPBAR_OFFSET_MOBILE="148"
# VITE_DERIV_DBOT_TOPBAR_OFFSET_TABLET="188"
# VITE_DERIV_DBOT_TOPBAR_OFFSET_DESKTOP="220"

# Optional OAuth callback override for production and local dev.
# Must match pre-registered redirect URIs in Deriv App Manager exactly.
# VITE_DERIV_REDIRECT_URI="https://your-domain.com/auth/deriv/callback"
# VITE_DERIV_REDIRECT_URI_LOCAL="http://localhost:3000/auth/deriv/callback"

# Optional: Signup destination for audience onboarding.
VITE_DERIV_SIGNUP_URL="https://deriv.com/signup"

# Server-side Supabase (required for checkout/order processing APIs)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Namecheap API (required for live availability checks)
NAMECHEAP_API_BASE="https://api.sandbox.namecheap.com/xml.response"
NAMECHEAP_API_USER="YOUR_NAMECHEAP_API_USER"
NAMECHEAP_API_KEY="YOUR_NAMECHEAP_API_KEY"
NAMECHEAP_USERNAME="YOUR_NAMECHEAP_USERNAME"
NAMECHEAP_CLIENT_IP="YOUR_WHITELISTED_PUBLIC_IP"
NAMECHEAP_AFFILIATE_URL_TEMPLATE="https://www.namecheap.com/domains/registration/results/?domain={{DOMAIN}}"

# Local/dev behavior
NAMECHEAP_ENABLE_MOCK_CHECK="true"
NAMECHEAP_ENABLE_REGISTRATION="false"

# Porkbun integration
PORKBUN_API_BASE="https://api.porkbun.com/api/json/v3"
PORKBUN_API_KEY="YOUR_PORKBUN_API_KEY"
PORKBUN_SECRET_API_KEY="YOUR_PORKBUN_SECRET_API_KEY"
PORKBUN_ENABLE_MOCK_CHECK="true"
PORKBUN_ENABLE_REGISTRATION="false"

# Optional: live registration contact profile
NAMECHEAP_CONTACT_FIRST_NAME="Domain"
NAMECHEAP_CONTACT_LAST_NAME="Owner"
NAMECHEAP_CONTACT_ADDRESS1="Nairobi Street 1"
NAMECHEAP_CONTACT_CITY="Nairobi"
NAMECHEAP_CONTACT_STATE="Nairobi"
NAMECHEAP_CONTACT_POSTAL="00100"
NAMECHEAP_CONTACT_COUNTRY="KE"
NAMECHEAP_CONTACT_PHONE="+254700000000"
NAMECHEAP_CONTACT_EMAIL="owner@example.com"
NAMECHEAP_CONTACT_ORG="DForge"
NAMECHEAP_CONTACT_TITLE="Founder"

# Optional: Vercel domain automation (for attach/verify steps)
VERCEL_TOKEN="YOUR_VERCEL_TOKEN"
VERCEL_PROJECT_ID="YOUR_VERCEL_PROJECT_ID"
VERCEL_TEAM_ID="YOUR_VERCEL_TEAM_ID"
